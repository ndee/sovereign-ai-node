{
  "comment": "Documentation ranges only (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24, 2001:db8::/32, 3fff::/20). They are classified PUBLIC on purpose. Each vector runs through a fresh masker.",
  "masked": [
    { "name": "public IPv4", "input": "resolved (203.0.113.7)", "expected": "resolved (<public-ipv4#1>)" },
    { "name": "public IPv4 with port", "input": "connect ECONNREFUSED 198.51.100.2:993", "expected": "connect ECONNREFUSED <public-ipv4#1>:993" },
    { "name": "two public IPv4, equality kept", "input": "a=192.0.2.1 b=192.0.2.2 c=192.0.2.1", "expected": "a=<public-ipv4#1> b=<public-ipv4#2> c=<public-ipv4#1>" },
    { "name": "IPv4 CIDR", "input": "route 203.0.113.0/24", "expected": "route <public-ipv4#1>/24" },
    { "name": "IPv4 at sentence end", "input": "address was 203.0.113.9.", "expected": "address was <public-ipv4#1>." },
    { "name": "IPv4 after key colon", "input": "addr:203.0.113.9", "expected": "addr:<public-ipv4#1>" },
    { "name": "IPv4 after a JSON escape", "input": "\\n203.0.113.10\\t", "expected": "\\n<public-ipv4#1>\\t" },
    { "name": "IPv4 after a percent escape", "input": "host%3D203.0.113.11", "expected": "host%3D<public-ipv4#1>" },
    { "name": "product token is masked (accepted over-masking)", "input": "Chrome/1.2.3.4", "expected": "Chrome/<public-ipv4#1>" },
    { "name": "CGNAT", "input": "wan 100.64.12.34 and 100.127.255.1", "expected": "wan <cgnat-ipv4#1> and <cgnat-ipv4#2>" },
    { "name": "just outside CGNAT is public", "input": "100.128.0.1", "expected": "<public-ipv4#1>" },
    { "name": "just outside 172.16/12 is public", "input": "172.32.0.1 172.15.0.1", "expected": "<public-ipv4#1> <public-ipv4#2>" },
    { "name": "compressed IPv6, :: in the middle", "input": "2001:db8::1", "expected": "<global-ipv6#1>" },
    { "name": "IPv6, :: at the end", "input": "prefix 2001:db8:1:2::", "expected": "prefix <global-ipv6#1>" },
    { "name": "full IPv6 with leading zeros", "input": "2001:0db8:0000:0000:0000:0000:0000:0001", "expected": "<global-ipv6#1>" },
    { "name": "upper/lower case and compression are the same address", "input": "2001:DB8::1 2001:db8:0:0::1 2001:0db8::0001", "expected": "<global-ipv6#1> <global-ipv6#1> <global-ipv6#1>" },
    { "name": "3fff::/20 documentation range", "input": "3fff:123::9", "expected": "<global-ipv6#1>" },
    { "name": "bracketed IPv6 with port", "input": "connect to [2001:db8::5]:993", "expected": "connect to [<global-ipv6#1>]:993" },
    { "name": "unbracketed Node connect error with :: (port swallowed)", "input": "connect ETIMEDOUT 2001:db8::5:443", "expected": "connect ETIMEDOUT <global-ipv6#1>" },
    { "name": "unbracketed full IPv6 with port (port kept)", "input": "connect ETIMEDOUT 2001:db8:1:2:3:4:5:6:443", "expected": "connect ETIMEDOUT <global-ipv6#1>:443" },
    { "name": "URL with bracketed host", "input": "https://[2001:db8::7]/path", "expected": "https://[<global-ipv6#1>]/path" },
    { "name": "URL query with %3A colons", "input": "?host=2001%3Adb8%3A%3A7&x=1", "expected": "?host=<global-ipv6#1>&x=1" },
    { "name": "URL query with %3a lower case", "input": "?host=2001%3adb8%3a%3a7", "expected": "?host=<global-ipv6#1>" },
    { "name": "percent-encoded bracket and colons", "input": "u=%5B2001%3Adb8%3A%3A7%5D%3A993", "expected": "u=%5B<global-ipv6#1>%5D%3A993" },
    { "name": "IPv6 in a JSON string", "input": "{\"address\":\"2001:db8::8\",\"family\":6}", "expected": "{\"address\":\"<global-ipv6#1>\",\"family\":6}" },
    { "name": "IPv6 after key colon (ifconfig style)", "input": "inet6 addr:2001:db8::3/64 Scope:Global", "expected": "inet6 addr:<global-ipv6#1>/64 Scope:Global" },
    { "name": "EUI-64 global", "input": "inet6 2001:db8:1:2:a8bb:ccff:fedd:eeff/64 scope global", "expected": "inet6 <global-ipv6#1>/64 scope global" },
    { "name": "EUI-64 ULA", "input": "inet6 fd12:3456:789a:1:a8bb:ccff:fedd:eeff/64", "expected": "inet6 <ula-ipv6#1>/64" },
    { "name": "EUI-64 link-local with zone", "input": "fe80::a8bb:ccff:fedd:eeff%eth0", "expected": "<link-local-ipv6#1>%eth0" },
    { "name": "link-local with %25-encoded zone", "input": "http://[fe80::1%25wlan0]:8080/", "expected": "http://[<link-local-ipv6#1>%25wlan0]:8080/" },
    { "name": "solicited-node multicast", "input": "ff02::1:ffdd:eeff", "expected": "<multicast-ipv6#1>" },
    { "name": "IPv4-mapped public", "input": "::ffff:203.0.113.7", "expected": "::ffff:<public-ipv4#1>" },
    { "name": "IPv4-mapped public in hex shares the IPv4 number", "input": "203.0.113.7 ::ffff:cb00:7107", "expected": "<public-ipv4#1> ::ffff:<public-ipv4#1>" },
    { "name": "IPv4-mapped CGNAT", "input": "::FFFF:100.64.0.9", "expected": "::ffff:<cgnat-ipv4#1>" },
    { "name": "NAT64", "input": "64:ff9b::203.0.113.7", "expected": "64:ff9b::<public-ipv4#1>" },
    { "name": "6to4", "input": "2002:cb00:7107::1", "expected": "<global-ipv6#1>" },
    { "name": "Teredo", "input": "2001:0:4136:e378:8000:63bf:3fff:fdd2", "expected": "<global-ipv6#1>" },
    { "name": "other IPv6 (fail safe)", "input": "100::1 ::203.0.113.1", "expected": "<other-ipv6#1> <other-ipv6#2>" },
    { "name": "standalone MAC, colon form", "input": "link/ether aa:bb:cc:dd:ee:ff brd ff:ff:ff:ff:ff:ff", "expected": "link/ether <mac#1> brd ff:ff:ff:ff:ff:ff" },
    { "name": "MAC, dash and upper case form, same number", "input": "AA-BB-CC-DD-EE-FF aa:bb:cc:dd:ee:ff", "expected": "<mac#1> <mac#1>" },
    { "name": "USB NIC interface names", "input": "dev enxaabbccddeeff up; wlx001122334455", "expected": "dev enx<mac#1> up; wlx<mac#2>" },
    { "name": "enx name as a zone id", "input": "fe80::1%enxaabbccddeeff", "expected": "<link-local-ipv6#1>%enx<mac#1>" },
    { "name": "classes number independently", "input": "203.0.113.1 2001:db8::1 203.0.113.2 2001:db8::2", "expected": "<public-ipv4#1> <global-ipv6#1> <public-ipv4#2> <global-ipv6#2>" }
  ],
  "readable": [
    "lan 192.168.1.20 10.0.0.1 172.16.0.1 172.31.255.255",
    "loopback 127.0.0.1 127.1.2.3 and ::1, unspecified 0.0.0.0 and ::",
    "link-local 169.254.12.34, multicast 224.0.0.251 239.255.255.250, broadcast 255.255.255.255",
    "mapped private ::ffff:192.168.1.5 and ::ffff:127.0.0.1",
    "listen [::]:8008 and [::1]:8787 and 0.0.0.0:443",
    "mac all zeros 00:00:00:00:00:00 and broadcast ff:ff:ff:ff:ff:ff"
  ],
  "falsePositives": [
