    "at 12:34:56 and 2026-10-05T12:34:56.789Z and 12:34:56.789 and 1:02:03:04",
    "sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
    "uuid 123e4567-e89b-12d3-a456-426614174000",
    "std::vector<int> tokio::runtime::Builder fs::read serde_json::from_str Foo::bar::1",
    "ratio 1:2 and 10:20:30 and a:b:c",
